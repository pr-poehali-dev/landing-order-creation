{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Login missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "", "password": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "noone@test.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without session",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    }
  ]
}